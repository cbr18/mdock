# Test stack
TEST_HTTP_PORT=18081
TEST_BASE_URL=http://127.0.0.1:18081

# HTTP
HTTP_ADDR=:8080

# Storage
VAULTS_ROOT=/vaults
DATA_DIR=/data
BACKUP_DIR=/backups

# Git and files
GIT_BIN=git
DEFAULT_FILE_ROOT=Obsidian Vault
COMMIT_DEBOUNCE=1s
LOCK_TTL=10s

# Auth/session
SESSION_TTL=1h
COOKIE_SECURE=false
FIRST_ADMIN_TOKEN=
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=test-password

# Request limits/rate limits
API_BODY_LIMIT_BYTES=1048576
WEBDAV_BODY_LIMIT_BYTES=52428800
AUTH_RATE_LIMIT_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW=1m
